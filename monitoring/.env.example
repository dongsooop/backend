# config/.env.grafana 로 복사해서 채운다 (README 2절). 채운 파일은 커밋하지 않는다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# 브라우저에서 접속할 주소. nginx /grafana/ 프록시 기준
GRAFANA_ROOT_URL=https://dongsoop.site/grafana/
# 앱 컨테이너(server-blue/green, nginx)와 elasticsearch 가 함께 붙어 있는 네트워크 (2026-09 서버 기준)
APP_NETWORK=dongsoop_app-network
# elasticsearch 컨테이너 이름:9200 (2026-09 서버 기준 8.12.0)
ES_URL=http://elasticsearch:9200
# UI 기본 언어. 계정별로는 프로필 > Preferences 에서 바꿀 수 있다
GRAFANA_LANGUAGE=ko-KR
